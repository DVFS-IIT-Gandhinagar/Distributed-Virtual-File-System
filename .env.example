# DVFS Admin Console Configuration

# Admin password hash (SHA-256 in hex format).
# Default below is the SHA-256 hash of "admin":
# 8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
ADMIN_PASSWORD_HASH=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918

# To generate a new SHA-256 hash for your custom password:
# Linux/WSL/macOS:
#   echo -n "your_password" | sha256sum
# Windows PowerShell:
#   [System.BitConverter]::ToString([System.Security.Cryptography.SHA256]::Create().ComputeHash([System.Text.Encoding]::UTF8.GetBytes("your_password"))).Replace("-","").ToLower()

# Google OAuth 2.0 Desktop Application Configuration
GOOGLE_CLIENT_ID=your_desktop_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_desktop_client_secret
GOOGLE_REDIRECT_URI=http://localhost:38485/logincallback
# Set to true for offline mock authentication testing
DVFS_AUTH_MOCK=false

# Optional: Cluster Administrator Google email (in addition to ADMIN_PASSWORD_HASH)
DVFS_ADMIN_EMAIL=admin@example.com

