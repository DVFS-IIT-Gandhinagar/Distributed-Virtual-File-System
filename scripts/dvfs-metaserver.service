[Unit]
Description=Distributed Virtual File System (DVFS) Metaserver
After=network-online.target mongod.service
Wants=network-online.target mongod.service

[Service]
Type=simple
# Dynamic user resolution: automatically detects the primary non-root user (UID 1000: e.g. ubuntu, rpi, jsm)
# or respects DVFS_USER / DVFS_REPO environment overrides if set.
Environment=META_PORT=50051
# Cluster metadata lives in MongoDB. Point this at the replica set:
#   Environment=MONGO_URI=mongodb://dvfs1:27017,dvfs2:27017,dvfs3:27017/dvfs?replicaSet=rs0
# Keep credentials out of this file; use
#   EnvironmentFile=/etc/dvfs/mongo.env   (mode 0600, MONGO_URI=... inside)
Environment=MONGO_URI=mongodb://127.0.0.1:27017/dvfs

ExecStart=/bin/bash -c '\
  USER_NAME=$${DVFS_USER:-$$(id -un 1000 2>/dev/null || whoami)}; \
  USER_HOME=$${DVFS_HOME:-$$(getent passwd "$$USER_NAME" | cut -d: -f6)}; \
  REPO_DIR="$${DVFS_REPO:-$$USER_HOME/Distributed-Virtual-File-System}"; \
  cd "$$REPO_DIR" || { echo "[DVFS ERROR] Repository directory $$REPO_DIR not found" >&2; exit 1; }; \
  if command -v runuser >/dev/null 2>&1; then \
    exec runuser -u "$$USER_NAME" -- /bin/bash "$$REPO_DIR/scripts/start-metaserver.sh"; \
  else \
    exec su "$$USER_NAME" -c "cd '\''$$REPO_DIR'\'' && exec /bin/bash '\''$$REPO_DIR/scripts/start-metaserver.sh'\''"; \
  fi'

Restart=on-failure
RestartSec=3s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
