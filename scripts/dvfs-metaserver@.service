[Unit]
Description=Distributed Virtual File System (DVFS) Metaserver for %i
After=network-online.target mongod.service
Wants=network-online.target mongod.service

[Service]
Type=simple
User=%i
WorkingDirectory=%h/Distributed-Virtual-File-System
Environment=META_PORT=50051
# Keep credentials out of this file; use
#   EnvironmentFile=/etc/dvfs/mongo.env   (mode 0600, MONGO_URI=... inside)
Environment=MONGO_URI=mongodb://127.0.0.1:27017/dvfs

ExecStart=/bin/bash %h/Distributed-Virtual-File-System/scripts/start-metaserver.sh

Restart=on-failure
RestartSec=3s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
