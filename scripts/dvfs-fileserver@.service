[Unit]
Description=Distributed Virtual File System (DVFS) Fileserver for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/Distributed-Virtual-File-System

# Environment settings:
# start-fileserver.sh automatically resolves FS_ID (%i -> fs<N>) and queries dvfs1 IP from Gist.
# Manual/Static IP overrides (uncomment if you want to hardcode a static IP or custom ID):
# Environment=META_ADDR=10.0.171.38:50051
# Environment=FS_ID=fs1
Environment=FS_PORT=50052
Environment=DATA_DIR=%h/Distributed-Virtual-File-System/fileserver_data

# ExecStart executes the auto-IP detecting startup wrapper
ExecStart=/bin/bash %h/Distributed-Virtual-File-System/scripts/start-fileserver.sh

Restart=on-failure
RestartSec=3s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
