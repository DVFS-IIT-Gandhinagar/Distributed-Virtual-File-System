[Unit]
Description=Distributed Virtual File System (DVFS) Admin Console for %i
After=network-online.target mongod.service dvfs-metaserver.service
Wants=network-online.target mongod.service

[Service]
Type=simple
User=%i
WorkingDirectory=%h/Distributed-Virtual-File-System
Environment=ADMIN_PORT=8080
# Keep credentials out of this file; use
#   EnvironmentFile=/etc/dvfs/mongo.env   (mode 0600, MONGO_URI=... inside)
Environment=MONGO_URI=mongodb://127.0.0.1:27017/dvfs
# gRPC address of the metaserver, used when an admin removes a node from the
# cluster. Leave unset to resolve it from the discovery Gist.
#Environment=DVFS_METASERVER_ADDR=127.0.0.1:50051

ExecStart=/bin/bash -l %h/Distributed-Virtual-File-System/scripts/start-admin.sh

Restart=on-failure
RestartSec=3s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
