[Unit]
Description=Distributed Virtual File System (DVFS) Admin Console for %i
After=network-online.target dvfs-metaserver.service
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/Distributed-Virtual-File-System
Environment=ADMIN_PORT=8080
Environment=STATE_FILE=%h/Distributed-Virtual-File-System/bin/metaserver_state.json

ExecStart=/bin/bash -l %h/Distributed-Virtual-File-System/scripts/start-admin.sh

Restart=on-failure
RestartSec=3s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
